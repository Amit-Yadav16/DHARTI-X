# Environment configuration for DHARTI-X Platform
# NEVER commit your actual API keys or secrets to version control.

# Gemini API Key (Obtain free tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=Your gemmini api key

# Open-Meteo API (Free / No-Key required for non-commercial research/prototyping)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Target Geography
DEFAULT_DISTRICT=Palghar
DEFAULT_STATE=Maharashtra

# Server Configuration
PORT=8000
FRONTEND_PORT=3000

